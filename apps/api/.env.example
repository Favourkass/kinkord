# --- runtime ---
PORT=4000
WEB_ORIGINS=http://localhost:3000

# --- database (local docker-compose default) ---
DATABASE_URL=postgres://kinkord:kinkord@localhost:5432/kinkord

# --- media storage ---
# Local: MinIO from docker-compose (no AWS account needed). Leave S3_ENDPOINT
# UNSET in deployed environments — the instance role provides credentials there.
MEDIA_BUCKET=kinkord-media
AWS_REGION=eu-west-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- auth ---
AUTH_SECRET=generate-a-long-random-string
AUTH_BASE_URL=http://localhost:4000

# --- email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Kinkord <no-reply@kinkord.com>

# --- sms (Robase) ---
# Robase (https://api.robase.dev) — transactional SMS for verification codes.
# Robase routes per country itself, so there is no NG-only switch any more.
ROBASE_API_KEY=
ROBASE_BASE_URL=https://api.robase.dev

# --- identity verification (Didit; server only, never NEXT_PUBLIC_*) ---
# Off unless every value below is set. Production ignores these and reads the
# kinkord/verification secret instead (infra/lib/verification-stack.ts).
# Create the workflow with scripts/provision-didit-bronze-workflow.mjs.
VERIFICATION_ENABLED=false
VERIFICATION_POLICY_URL=http://localhost:3000/privacy/verification
VERIFICATION_RETURN_URL=http://localhost:3000/settings/verification
DIDIT_MODE=sandbox
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
# Compare the live selfie with the profile photo (score 90-100); otherwise an admin checks it.
DIDIT_PROFILE_FACE_MATCH_ENABLED=false
DIDIT_PROFILE_FACE_MATCH_THRESHOLD=90
# Keys the one-way identity fingerprint. Any random string of 32+ characters.
VERIFICATION_BINDING_SECRET=
# Only for the provisioning script's sandbox runs.
DIDIT_SANDBOX_API_KEY=
