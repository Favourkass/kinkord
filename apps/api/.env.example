# --- runtime ---
PORT=4000
WEB_ORIGINS=http://localhost:3000

# --- database (local docker-compose default) ---
DATABASE_URL=postgres://kinkord:kinkord@localhost:5432/kinkord

# --- media storage ---
# Local: MinIO from docker-compose (no AWS account needed). Leave S3_ENDPOINT
# UNSET in deployed environments — the instance role provides credentials there.
MEDIA_BUCKET=kinkord-media
AWS_REGION=eu-west-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- auth ---
AUTH_SECRET=generate-a-long-random-string
AUTH_BASE_URL=http://localhost:4000

# --- email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Kinkord <no-reply@kinkord.com>

# --- sms (Robase) ---
# Robase (https://api.robase.dev) — transactional SMS for verification codes.
# Robase routes per country itself, so there is no NG-only switch any more.
ROBASE_API_KEY=
ROBASE_BASE_URL=https://api.robase.dev

# --- Kinkord KYC through Didit live (server only; never NEXT_PUBLIC_*) ---
# Configure a published LIVE workflow with government-issued national ID,
# liveness, ID-to-face comparison, Proof of Address, and Device/IP Analysis.
DIDIT_API_KEY=
DIDIT_MODE=live
DIDIT_LIVE_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_RETURN_URL=https://kinkord.com/settings/kyc
BRONZE_POLICY_URL=https://kinkord.com/privacy/kyc
# A strict 90-100 score is required; uncertain comparisons are sent to staff review.
DIDIT_PROFILE_FACE_MATCH_ENABLED=true
DIDIT_PROFILE_FACE_MATCH_THRESHOLD=90
# Separate server-only HMAC key used to compare verified-ID and bank identities
# without storing a legal name. Use a random value of at least 32 characters.
KYC_IDENTITY_BINDING_SECRET=
# Provision sandbox credentials in the Smile ID portal before enabling.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENVIRONMENT=sandbox
SMILE_ID_CALLBACK_URL=http://localhost:4000/webhooks/smile-id
# Approved Kinkord privacy notice describing biometric/ID processing and retention.
SMILE_ID_POLICY_URL=
# Comma-separated exact emails for authorized manual reviewers; each must enable 2FA.
BRONZE_REVIEWER_EMAILS=

# --- Active Kinkord KYC address and location evidence ---
# Requires the approved privacy notice and a live Didit workflow with Proof of Address.
# Browser GPS is sent only for one in-memory comparison and is never stored.
KYC_RESIDENCE_ENABLED=true
KYC_LOCATION_ENABLED=true
KYC_GPS_RESIDENCE_DISTANCE_KM=50
KYC_POA_MAX_AGE_DAYS=90

# --- Paused financial-account verification (not part of the active KYC seal) ---
MONO_FINANCIAL_KYC_ENABLED=false
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
MONO_REDIRECT_URL=http://localhost:3000/settings/kyc

# Exact emails of KYC case reviewers. Every listed account must have 2FA enabled.
KYC_REVIEWER_EMAILS=
