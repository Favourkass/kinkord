# --- runtime ---
PORT=4000
WEB_ORIGINS=http://localhost:3000

# --- database (local docker-compose default) ---
DATABASE_URL=postgres://kinkord:kinkord@localhost:5432/kinkord

# --- media storage ---
# Local: MinIO from docker-compose (no AWS account needed). Leave S3_ENDPOINT
# UNSET in deployed environments — the instance role provides credentials there.
MEDIA_BUCKET=kinkord-media
AWS_REGION=eu-west-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- auth ---
AUTH_SECRET=generate-a-long-random-string
AUTH_BASE_URL=http://localhost:4000

# --- email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Kinkord <no-reply@kinkord.com>

# --- sms (Termii) ---
TERMII_API_KEY=
TERMII_BASE_URL=https://v4.api.termii.com
TERMII_SENDER_ID=KINKORD
# "generic" until Termii activates the DND route on the workspace, then "dnd"
TERMII_CHANNEL=generic

# --- Bronze identity verification (server only; never NEXT_PUBLIC_*) ---
# Didit is primary. Configure a published workflow with Nigeria NIN/BVN
# registry validation, government ID, liveness, and ID-to-face comparison.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_RETURN_URL=http://localhost:3000/settings/verification/bronze
BRONZE_POLICY_URL=
# Provision sandbox credentials in the Smile ID portal before enabling.
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENVIRONMENT=sandbox
SMILE_ID_CALLBACK_URL=http://localhost:4000/webhooks/smile-id
# Approved Kinkord privacy notice describing biometric/ID processing and retention.
SMILE_ID_POLICY_URL=
# Comma-separated exact emails for authorized manual reviewers; each must enable 2FA.
BRONZE_REVIEWER_EMAILS=
